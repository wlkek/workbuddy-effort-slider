Option Explicit
' WorkBuddy mod launcher
' 1) 记录一次启动痕迹（排查用）
' 2) 如果客户端还在跑，提示先完全退出（否则单实例锁会吞掉新实例）
' 3) 用 Node 模式跑 injector，由它带 --inspect 拉起客户端
Dim sh, fso, svc, procs, p, cl, running
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

Sub Note(msg)
  On Error Resume Next
  Dim h
  Set h = fso.OpenTextFile("{{LOG}}", 8, True)
  h.WriteLine Now & " " & msg
  h.Close
End Sub

Note "launch start"

Set svc = GetObject("winmgmts:\\.\root\cimv2")
Set procs = svc.ExecQuery("select ProcessId, CommandLine from Win32_Process where Name='WorkBuddy.exe'")
running = False
For Each p In procs
  cl = p.CommandLine & ""
  If InStr(cl, "--type=") = 0 And InStr(cl, "daemon-app-server") = 0 And InStr(cl, "cli\bin") = 0 And InStr(cl, "injector.js") = 0 Then
    running = True
  End If
Next

If running Then
  Note "already running, abort"
  MsgBox "WorkBuddy 还在运行。" & vbCrLf & vbCrLf & "请先从托盘点右键完全退出，再用这个快捷方式启动。", 48, "WorkBuddy mods"
  WScript.Quit
End If

sh.Environment("PROCESS")("ELECTRON_RUN_AS_NODE") = "1"
sh.Environment("PROCESS")("WB_APP_EXE") = "{{EXE}}"
Note "spawn injector"
sh.Run """{{EXE}}"" ""{{INJECTOR}}""", 0, False
