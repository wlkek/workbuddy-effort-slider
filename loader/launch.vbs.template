Option Explicit
' WorkBuddy mod launcher
'   客户端已经在跑 → 把已有窗口带到前台，立即退出，不重复起实例
'   没在跑         → 隐藏运行注入器，由它带 --inspect 启动客户端

Dim sh, fso, svc, procs, p, cl, running
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

Sub Note(msg)
  On Error Resume Next
  Dim h
  Set h = fso.OpenTextFile("{{LOG}}", 8, True)
  h.WriteLine Now & " " & msg
  h.Close
End Sub

Note "launch start"

running = False
On Error Resume Next
Set svc = GetObject("winmgmts:\\.\root\cimv2")
Set procs = svc.ExecQuery("select CommandLine from Win32_Process where Name='WorkBuddy.exe'")
For Each p In procs
  cl = p.CommandLine & ""
  If InStr(cl, "--type=") = 0 And InStr(cl, "daemon-app-server") = 0 And InStr(cl, "cli\bin") = 0 And InStr(cl, "injector.js") = 0 Then
    running = True
  End If
Next
On Error GoTo 0

If running Then
  Note "already running, focus"
  ' 先激活已有窗口；如果它在托盘里没有可见窗口，就正常启动一次，
  ' 交给客户端的单实例逻辑把窗口调出来
  If Not sh.AppActivate("WorkBuddy") Then
    sh.Run """{{EXE}}""", 1, False
  End If
  WScript.Quit
End If

sh.Environment("PROCESS")("ELECTRON_RUN_AS_NODE") = "1"
sh.Environment("PROCESS")("WB_APP_EXE") = "{{EXE}}"
Note "spawn injector"
sh.Run """{{EXE}}"" ""{{INJECTOR}}""", 0, False
